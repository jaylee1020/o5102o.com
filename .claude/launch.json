{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static Server (Python)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8081"],
      "port": 8081
    },
    {
      "name": "Static Server (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3000"],
      "port": 3000
    },
    {
      "name": "Default App",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8082", "-d", "default"],
      "port": 8082
    }
  ]
}
